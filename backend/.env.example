# Django Settings
DEBUG=True
SECRET_KEY=change-me-in-production-use-a-strong-random-secret-key
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL with psycopg)
DB_NAME=pashuchara_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# CSRF Settings
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public frontend origin (embedded in batch QR codes as the report link)
FRONTEND_URL=http://localhost:5173

# Groq AI (vision-capable chat completions)
GROQ_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# OpenWeatherMap
OPENWEATHER_KEY=
