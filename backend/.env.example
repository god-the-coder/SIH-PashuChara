# Django Settings
# Set to "production" on Render (or any real deployment) to load
# config/settings/production.py instead of development.py — see
# config/settings/__init__.py
DJANGO_ENV=development
DEBUG=True
SECRET_KEY=change-me-in-production-use-a-strong-random-secret-key
# Add your machine's LAN IP here too when testing the Capacitor Android app
# on a device/emulator (it can't reach the backend via "localhost").
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL with psycopg)
DB_NAME=pashuchara_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# CORS Settings
# https://localhost is the origin the Capacitor Android app sends when
# server.androidScheme is "https" (see frontend/capacitor.config.json)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost

# CSRF Settings
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost

# Public frontend origin (embedded in batch QR codes as the report link)
FRONTEND_URL=http://localhost:5173

# Gemini AI (visual inspection analysis — vision-capable multimodal generation)
GEMINI_KEY=
GEMINI_MODEL=gemini-3.5-flash

# OpenWeatherMap
OPENWEATHER_KEY=

# Google OAuth2 — Server-side ID token verification
# Get from Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Required on Render (production) — leave blank in local dev to use the legacy fallback
GOOGLE_CLIENT_ID=
